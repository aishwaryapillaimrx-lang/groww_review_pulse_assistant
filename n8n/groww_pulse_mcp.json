{
  "name": "Groww Pulse MCP",
  "nodes": [
    {
      "parameters": {
        "authentication": "bearerAuth",
        "path": "groww-pulse"
      },
      "id": "11111111-1111-4111-8111-111111111111",
      "name": "MCP Server Trigger",
      "type": "@n8n/n8n-nodes-langchain.mcpTrigger",
      "typeVersion": 1,
      "position": [0, 0],
      "webhookId": "groww-pulse"
    },
    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Append one weekly pulse entry as plain text to the end of the shared Google Doc.",
        "operation": "update",
        "documentURL": "REPLACE_WITH_YOUR_GOOGLE_DOC_ID_OR_URL",
        "actionsUi": {
          "actionFields": [
            {
              "action": "insert",
              "object": "text",
              "insertSegment": "body",
              "locationChoice": "endOfSegmentLocation",
              "text": "={{ $fromAI('entry_text', 'The full plain-text pulse entry to append to the document', 'string') }}"
            }
          ]
        }
      },
      "id": "22222222-2222-4222-8222-222222222222",
      "name": "append_to_doc",
      "type": "n8n-nodes-base.googleDocsTool",
      "typeVersion": 2,
      "position": [-220, 260]
    },
    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Create a Gmail DRAFT (never sent) with the given subject and plain-text body.",
        "resource": "draft",
        "subject": "={{ $fromAI('subject', 'The email subject line', 'string') }}",
        "emailType": "text",
        "message": "={{ $fromAI('body', 'The plain-text email body', 'string') }}",
        "options": {
          "sendTo": "REPLACE_WITH_YOUR_EMAIL"
        }
      },
      "id": "33333333-3333-4333-8333-333333333333",
      "name": "create_email_draft",
      "type": "n8n-nodes-base.gmailTool",
      "typeVersion": 2.1,
      "position": [220, 260]
    }
  ],
  "connections": {
    "append_to_doc": {
      "ai_tool": [[{ "node": "MCP Server Trigger", "type": "ai_tool", "index": 0 }]]
    },
    "create_email_draft": {
      "ai_tool": [[{ "node": "MCP Server Trigger", "type": "ai_tool", "index": 0 }]]
    }
  },
